# Copy to .env.local on each server and fill in. Never commit real values.

# ---- the site (Iranian server) ----
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=
# signing secrets for our own processes; long random strings (e.g. `openssl rand -hex 32`)
RELAY_SECRET=
BALE_BOT_SECRET=
# Supabase Auth «Send SMS» hook secret, as Supabase shows it (v1,whsec_…); several separated by |
SEND_SMS_HOOK_SECRET=
# SMS.ir: API key and the id of the approved login-code template (its parameter name, default CODE)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAM=CODE

# ---- the Bale bot (same Iranian server) ----
BALE_BOT_TOKEN=
CORE_URL=http://127.0.0.1:3000
# BALE_BOT_SECRET as above

# ---- the relay (server outside Iran) ----
# CORE_URL=https://your-site-in-iran
# RELAY_SECRET as above
OPENAI_API_KEY=
AI_MODEL=
STT_MODEL=
TELEGRAM_BOT_TOKEN=
RELAY_WORKERS=2
